# Copy to .env and fill in. NEVER commit .env.

# Connection string used by the API (external SQL Server, or the bundled one with --profile localdb).
CONNECTION_STRING=Data Source=your-sql-host,1433;Initial Catalog=MikrotikScheduler;User ID=sa;Password=CHANGE_ME;Encrypt=True;Trust Server Certificate=True;Connect Timeout=30

# JWT signing key, at least 32 random characters. Generate: openssl rand -base64 48
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32+

# Only for the optional bundled SQL Server (docker compose --profile localdb up)
MSSQL_SA_PASSWORD=Your_strong_Passw0rd

API_PORT=5133
WEB_PORT=5200
