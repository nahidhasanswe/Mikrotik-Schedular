@model RouterFormModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add router" : "Edit router"; }
<h2>@ViewData["Title"]</h2>
<form asp-action="Save" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="row">
        <div class="col-8 mb-3"><label asp-for="Host" class="form-label"></label><input asp-for="Host" class="form-control" /></div>
        <div class="col-4 mb-3"><label asp-for="Port" class="form-label"></label><input asp-for="Port" class="form-control" /></div>
    </div>
    <div class="form-check mb-3"><input asp-for="UseSsl" class="form-check-input" /><label asp-for="UseSsl" class="form-check-label"></label> <span class="text-muted">(port 8729)</span></div>
    <div class="mb-3"><label asp-for="ApiUsername" class="form-label"></label><input asp-for="ApiUsername" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ApiPassword" class="form-label"></label><input asp-for="ApiPassword" class="form-control" autocomplete="new-password" />
        @if (Model.Id != 0) { <div class="form-text">Leave blank to keep the current password.</div> }</div>
    <button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
