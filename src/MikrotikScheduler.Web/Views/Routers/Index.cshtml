@model List<RouterDto>
@{ ViewData["Title"] = "Routers"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mikrotik routers</h2>
    <a asp-action="Create" class="btn btn-primary">Add router</a>
</div>
<table class="table table-striped align-middle">
    <thead><tr><th>Name</th><th>Host</th><th>API user</th><th>Status</th><th>Last seen (UTC)</th><th>PPPoE users</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Name</td>
            <td>@r.Host:@r.Port @(r.UseSsl ? "(SSL)" : "")</td>
            <td>@r.ApiUsername</td>
            <td><span class="badge @(r.IsOnline ? "bg-success" : "bg-secondary")">@(r.IsOnline ? "Online" : "Offline")</span></td>
            <td>@(r.LastSeenAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
            <td><a asp-controller="PppoeUsers" asp-action="Index" asp-route-routerId="@r.Id">@r.PppoeUserCount</a></td>
            <td class="text-end text-nowrap">
                <form asp-action="Test" asp-route-id="@r.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Test</button></form>
                <form asp-action="Sync" asp-route-id="@r.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-primary">Sync now</button></form>
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this router and its PPPoE users from this system? (Nothing is removed on the router.)')"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-muted">No routers yet.</td></tr> }
    </tbody>
</table>
