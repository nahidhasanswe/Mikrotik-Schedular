@model List<SyncLogDto>
@{ ViewData["Title"] = "Sync logs"; }
<h2>Sync logs</h2>
<table class="table table-sm table-striped">
    <thead><tr><th>Time (UTC)</th><th>Router</th><th>Action</th><th>Result</th><th>Message</th></tr></thead>
    <tbody>
    @foreach (var l in Model)
    {
        <tr><td>@l.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@l.RouterId</td><td>@l.Action</td>
            <td><span class="badge @(l.Success ? "bg-success" : "bg-danger")">@(l.Success ? "OK" : "Failed")</span></td><td>@l.Message</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-muted">Nothing yet.</td></tr> }
    </tbody>
</table>
