# Copy to .env on the server and fill in. NEVER commit .env.

# Public hostname (DNS A record must point to this server). Used by nginx-proxy and Let's Encrypt.
DOMAIN=scheduler.example.com
LETSENCRYPT_EMAIL=you@example.com

# Docker network that your nginx-proxy container is on. Find it with:
#   docker inspect <nginx-proxy-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=nginx-proxy

# SQL Server installed on the HOST (reached through host.docker.internal)
CONNECTION_STRING=Data Source=host.docker.internal,1433;Initial Catalog=MikrotikScheduler;User ID=mikrotik_app;Password=CHANGE_ME;Encrypt=True;Trust Server Certificate=True;Connect Timeout=30

# Generate: openssl rand -base64 48
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32+
